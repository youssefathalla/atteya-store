{
  "name": "atteya-store",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "node scripts/build.mjs",
    "build:dev": "ng build --configuration dev",
    "build:prod": "ng build --configuration production",
    "preflight": "node scripts/sync-pricing-engine.mjs --check && node scripts/pre-flight-check.mjs && eslint .",
    "sync:agents": "node scripts/sync-agent-docs.mjs",
    "sync:agents:check": "node scripts/sync-agent-docs.mjs --check",
    "sync:engine": "node scripts/sync-pricing-engine.mjs",
    "sync:engine:check": "node scripts/sync-pricing-engine.mjs --check",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "test:cart": "node --experimental-strip-types --test scripts/cart-pricing.spec.mjs",
    "serve:ssr:atteya-store": "node dist/atteya-store/server/server.mjs",
    "fb:guard": "node scripts/firebase-guard.mjs",
    "fb:indexes:check:dev": "node scripts/check-indexes.mjs dev",
    "fb:indexes:check:prod": "node scripts/check-indexes.mjs prod",
    "fb:deploy:dev": "node scripts/deploy.mjs dev firestore,storage,functions",
    "fb:deploy:prod": "node scripts/deploy.mjs prod firestore,storage,functions",
    "fb:indexes:dev": "node scripts/deploy.mjs dev firestore:indexes",
    "fb:indexes:prod": "node scripts/deploy.mjs prod firestore:indexes",
    "fb:rules:dev": "node scripts/deploy.mjs dev firestore:rules,storage",
    "fb:rules:prod": "node scripts/deploy.mjs prod firestore:rules,storage",
    "fb:fn:dev": "node scripts/deploy.mjs dev functions",
    "fb:fn:prod": "node scripts/deploy.mjs prod functions"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "algoliasearch": "^5.60.0",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/google.maps": "^3.66.0",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.5.0",
    "countries-and-timezones": "^3.9.0",
    "eslint": "^10.9.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
