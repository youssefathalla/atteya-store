{
  "name": "atteya-store",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint .",
    "serve:ssr:atteya-store": "node dist/atteya-store/server/server.mjs",
    "fb:use:dev": "firebase use dev",
    "fb:use:prod": "firebase use prod",
    "fb:deploy:dev": "ng build -c development && firebase deploy -P dev",
    "fb:deploy:prod": "ng build -c production && firebase deploy -P prod",
    "fb:fn:dev": "firebase deploy --only functions -P dev",
    "fb:fn:prod": "firebase deploy --only functions -P prod",
    "fb:rules:dev": "firebase deploy --only firestore:rules,storage -P dev",
    "fb:rules:prod": "firebase deploy --only firestore:rules,storage -P prod"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@jsverse/transloco": "^8.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "express": "^5.1.0",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/google.maps": "^3.66.0",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.9.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
