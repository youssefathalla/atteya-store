rules_version = '2';

// Four roles:
//  - Visitor (signed out): public storefront reads only.
//  - Normal user (signed in, no admin or staff claim): same as a visitor, plus read of their own roles/{uid} mirror.
//  - Staff (token.role == 'staff' AND session not revoked): manage store content (canManageStore()).
//  - Admin (token.role == 'admin' AND session not revoked): same as staff, plus the Team list,
//    its audit trail, and (through callables) deleting orders and changing roles.
// roles/ and auditLogs/ are written only by the Admin SDK (Cloud Functions / scripts).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin: the whole dashboard, plus deleting orders and managing who has access (both through callables).
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin' && sessionIsCurrent();
    }

    // Admin or staff: everything the dashboard reads and writes from the browser.
    function canManageStore() {
      return isSignedIn() && request.auth.token.role in ['admin', 'staff'] && sessionIsCurrent();
    }

    // An ID token keeps its role claim until it expires. After refresh tokens are
    // revoked, roles/{uid}.revokeTimeMs is the Auth tokensValidAfterTime in
    // milliseconds. Sessions that started before that time are rejected.
    // A missing mirror, or a mirror with no revokeTimeMs, stays allowed.
    function sessionIsCurrent() {
      let rolePath = /databases/$(database)/documents/roles/$(request.auth.uid);
      return !exists(rolePath) || freshSession(get(rolePath).data);
    }

    function freshSession(data) {
      return !('revokeTimeMs' in data)
        || ('auth_time' in request.auth.token
            && request.auth.token.auth_time * 1000 >= data.revokeTimeMs);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Storefront content: settings/home, settings/navigation, settings/shipping,
    // settings/currency, and sibling docs.
    // Visitors and normal users can read these. Only an admin with a current session can write them.
    // settings/currency holds combined display factors and is written only by Cloud Functions.
    // Subcollections under settings are denied. The app does not write them.
    // settings/navigation and settings/home must name their saver in updatedBy (ATS-251), so
    // Previous Versions can't be credited to someone else.
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if canManageStore() && docId != 'currency'
        && (!(docId in ['navigation', 'home']) || request.resource.data.updatedBy == request.auth.uid);
      allow delete: if canManageStore() && docId != 'currency';
    }

    // Previous Versions of settings/navigation and settings/home (ATS-251). Written only by the
    // onSettingsHistoryWrite trigger (Admin SDK); dashboard staff read them, nobody writes from a client.
    match /settingsHistory/{docId} {
      allow read, write: if false;
    }

    match /settingsHistory/{docId}/versions/{versionId} {
      allow read: if canManageStore();
      allow write: if false;
    }

    // Markup and raw exchange rates. Admin SDK (callables and the daily schedule) is the only writer.
    // Clients, including admins, cannot create or edit these docs.
    match /intlPricing/{docId} {
      allow read: if canManageStore();
      allow write: if false;
    }

    // Role mirror and audit trail. The Admin SDK (script and callables) is the
    // only writer. Clients, including admins, cannot create or edit these.
    // The signed-in person can read their own mirror so the app can refresh a changed role.
    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Products: storefront can read published products; admins can read all.
    // Public queries MUST include where('published', '==', true) or they are rejected.
    // Writes go only through admin callables (createProduct, updateProduct, setProductStock,
    // confirmCodOrder) and the Paymob webhook, which use the Admin SDK and keep stock,
    // stockBySize and inStock consistent via stockFields(). Clients, including admins,
    // cannot write product docs directly.
    match /products/{productId} {
      allow get, list: if resource.data.published == true || canManageStore();
      allow write: if false;
    }

    // Categories and brands: storefront can read published docs; only admins write.
    // Public queries MUST include where('published', '==', true) or they are rejected.
    match /categories/{categoryId} {
      allow get, list: if resource.data.published == true || canManageStore();
      allow create, update, delete: if canManageStore();
    }

    match /brands/{brandId} {
      allow get, list: if resource.data.published == true || canManageStore();
      allow create, update, delete: if canManageStore();
    }

    // Offers: public active offers can be read by shoppers; only admins write.
    // Coupon codes (offerCodes) are admin-only; usage counters (offerUsage) are Admin SDK only.
    match /offers/{offerId} {
      allow get, list: if (resource.data.active == true && resource.data.visibility == 'public') || canManageStore();
      allow create, update, delete: if canManageStore();
    }

    match /offerCodes/{offerId} {
      allow read, write: if canManageStore();
    }

    match /offerUsage/{offerId} {
      allow read: if canManageStore();
      allow write: if false;
    }

    match /orders/{orderId} {
      allow get: if isOwner(resource.data.customerId) || canManageStore();
      allow list: if canManageStore() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // One summary per customer email (ATS-276), written only by Cloud Functions.
    match /customers/{customerId} {
      allow read: if canManageStore();
      allow write: if false;
    }

    // Private staff note on one customer (ATS-278), written from the admin customer page.
    match /customerNotes/{customerId} {
      allow read: if canManageStore();
      allow create, update: if canManageStore()
        && request.resource.data.keys().hasOnly(['note', 'updatedAt', 'updatedBy', 'updatedByEmail'])
        && request.resource.data.keys().hasAll(['note', 'updatedAt', 'updatedBy', 'updatedByEmail'])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.get('email', '');
      allow delete: if false;
    }

    // Staff-only side of an order (status history with staff emails, cancel reason), kept off
    // orders/{id} because the owner can read that doc. Written by the Admin SDK only.
    match /orderStaffNotes/{orderId} {
      allow read: if canManageStore();
      allow write: if false;
    }

    // Public read-by-key copy of a guest order (only the fields the order page reads), written by
    // the syncOrderView trigger. The 43-character random key is the secret; listing is denied.
    match /orderViews/{viewKey} {
      allow get: if true;
      allow list, write: if false;
    }

    // Per-uid and guest daily checkout counters. Admin SDK only.
    match /orderRateLimits/{id} {
      allow read, write: if false;
    }

    // Paymob webhook idempotency keys. Admin SDK only.
    match /paymobWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // One doc per order email (`{orderId}_{kind}`): sent / failed status for admins.
    // Only the sendOrderEmails trigger (Admin SDK) writes it.
    match /orderEmails/{emailId} {
      allow read: if canManageStore();
      allow write: if false;
    }

    // Return and exchange requests (ATS-291): saved by the requestReturn / cancelReturnRequest
    // callables, read by admin and staff only. Shoppers see their request through the order's
    // `returns` summary (orders are server-written only). Staff-only notes go in returnStaffNotes.
    match /returnRequests/{requestId} {
      allow read: if canManageStore();
      allow write: if false;
    }

    match /returnStaffNotes/{requestId} {
      allow read: if canManageStore();
      allow write: if false;
    }

    // One claim per (return request, email), written only by the sendReturnEmails trigger.
    match /returnEmails/{emailId} {
      allow read: if canManageStore();
      allow write: if false;
    }

    // Footer email sign-ups (new arrivals and offers) and their per-connection daily counters.
    // Only the subscribeToEmails callable (Admin SDK) reads or writes them. No client access,
    // admins included: the list holds personal emails and is exported from the console.
    match /emailSignups/{id} {
      allow read, write: if false;
    }

    match /emailSignupRateLimits/{id} {
      allow read, write: if false;
    }

    // Confirm-your-email send counter (sendVerificationEmail). Admin SDK only.
    match /emailVerificationSends/{id} {
      allow read, write: if false;
    }

    // Per-shopper favorites. Only that signed-in person can read or change their list.
    // Docs live at favorites/{uid}/items/{productId}. Parent favorites/{uid} is unused.
    match /favorites/{uid} {
      allow read, write: if false;

      match /items/{productId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && productId.size() > 0
          && productId.size() <= 128
          && request.resource.data.keys().hasOnly(['productId', 'slug', 'addedAt'])
          && request.resource.data.productId == productId
          && request.resource.data.slug is string
          && request.resource.data.slug.size() >= 1
          && request.resource.data.slug.size() <= 200
          && request.resource.data.addedAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    // Per-shopper bag. Only that signed-in person can read or save it; admins get no access.
    // carts/{uid}: lines (product id, variant id, choices, quantity and picked gifts per line; never prices)
    // and updatedAt. Guests keep their bag in the browser instead.
    match /carts/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validCart(request.resource.data);
      allow delete: if false;
    }

    // At most 20 lines, the order callables' limit. Rules have no loops, so each index is checked on its own;
    // indexes past the end stop at the size check.
    function validCart(data) {
      return data.keys().hasOnly(['lines', 'updatedAt'])
        && data.lines is list
        && data.lines.size() <= 20
        && data.updatedAt == request.time
        && cartLineAt(data.lines, 0)
        && cartLineAt(data.lines, 1)
        && cartLineAt(data.lines, 2)
        && cartLineAt(data.lines, 3)
        && cartLineAt(data.lines, 4)
        && cartLineAt(data.lines, 5)
        && cartLineAt(data.lines, 6)
        && cartLineAt(data.lines, 7)
        && cartLineAt(data.lines, 8)
        && cartLineAt(data.lines, 9)
        && cartLineAt(data.lines, 10)
        && cartLineAt(data.lines, 11)
        && cartLineAt(data.lines, 12)
        && cartLineAt(data.lines, 13)
        && cartLineAt(data.lines, 14)
        && cartLineAt(data.lines, 15)
        && cartLineAt(data.lines, 16)
        && cartLineAt(data.lines, 17)
        && cartLineAt(data.lines, 18)
        && cartLineAt(data.lines, 19);
    }

    function cartLineAt(lines, i) {
      return lines.size() <= i || validCartLine(lines[i]);
    }

    // Quantity 1-20 per line. Choices are option id -> value id, at most 10 options.
    // Optional gifts: the free gifts picked for the line (at most 5); checkout re-checks each one.
    function validCartLine(line) {
      return line is map
        && line.keys().hasOnly(['productId', 'variantId', 'selection', 'quantity', 'gifts'])
        && (!('gifts' in line) || (line.gifts is list && line.gifts.size() <= 5))
        && line.productId is string
        && line.productId.size() > 0
        && line.productId.size() <= 128
        && (line.variantId == null || (line.variantId is string && line.variantId.size() <= 128))
        && line.selection is map
        && line.selection.size() <= 10
        && line.quantity is int
        && line.quantity >= 1
        && line.quantity <= 20;
    }

    // Shopper profile. Owner creates it once with signup consent (termsAcceptedAt, termsVersion,
    // marketingOptIn, marketingOptInAt). Later the owner may update only the /account fields:
    // name, phone, the one saved address, and the marketing choice. The terms fields never change.
    match /users/{uid} {
      allow read: if isOwner(uid) || canManageStore();
      allow create: if isOwner(uid) && validSignupConsent(request.resource.data);
      allow update: if isOwner(uid) && validProfileUpdate();
      allow delete: if false;
    }

    function validSignupConsent(data) {
      return data.keys().hasOnly([
          'termsAcceptedAt',
          'termsVersion',
          'marketingOptIn',
          'marketingOptInAt',
        ])
        && data.termsAcceptedAt == request.time
        && data.termsVersion is string
        && data.termsVersion.size() > 0
        && data.termsVersion.size() <= 64
        && data.marketingOptIn is bool
        && data.marketingOptInAt == request.time;
    }

    function validProfileUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'phone', 'address', 'marketingOptIn', 'marketingOptInAt', 'updatedAt'])
        && data.keys().hasOnly([
          'termsAcceptedAt',
          'termsVersion',
          'marketingOptIn',
          'marketingOptInAt',
          'name',
          'phone',
          'address',
          'updatedAt',
        ])
        && data.updatedAt == request.time
        && data.marketingOptIn is bool
        && (!changed.hasAny(['marketingOptIn', 'marketingOptInAt']) || data.marketingOptInAt == request.time)
        && (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 120))
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 20))
        && (!('address' in data) || data.address == null || validSavedAddress(data.address));
    }

    function optionalText(map, key, max) {
      return !(key in map) || map[key] == null || (map[key] is string && map[key].size() <= max);
    }

    function validSavedAddress(address) {
      return address is map
        && address.keys().hasOnly(['fullName', 'line1', 'line2', 'city', 'region', 'postalCode', 'country', 'phone'])
        && address.keys().hasAll(['fullName', 'line1', 'city', 'country', 'phone'])
        && address.fullName is string && address.fullName.size() >= 1 && address.fullName.size() <= 120
        && address.line1 is string && address.line1.size() >= 1 && address.line1.size() <= 200
        && optionalText(address, 'line2', 200)
        && address.city is string && address.city.size() >= 1 && address.city.size() <= 80
        && optionalText(address, 'region', 80)
        && optionalText(address, 'postalCode', 20)
        && address.country is string && address.country.size() == 2
        && address.phone is string && address.phone.size() >= 6 && address.phone.size() <= 20;
    }

    // Written only by Cloud Functions (offer pricing refresh bookkeeping). No client access.
    match /offerState/{id} {
      allow read, write: if false;
    }

    // Written only by Cloud Functions (products that failed to reach search). Admins read the count.
    match /searchSyncErrors/{id} {
      allow read: if canManageStore();
      allow write: if false;
    }

    // Deny by default. Admins can reach future collections, but a matching
    // {document=**} rule is OR-ed with the rules above, so settings, roles,
    // auditLogs, products, categories, brands, offers, offerCodes, offerUsage,
    // intlPricing, offerState, searchSyncErrors, settingsHistory, customers and customerNotes stay on the rules written for them.
    match /{collection}/{document=**} {
      allow read, write: if canManageStore() && !(collection in ['settings', 'roles', 'auditLogs', 'products', 'categories', 'brands', 'offers', 'offerCodes', 'offerUsage', 'intlPricing', 'orders', 'orderStaffNotes', 'orderViews', 'orderRateLimits', 'paymobWebhookEvents', 'orderEmails', 'favorites', 'carts', 'users', 'emailSignups', 'emailSignupRateLimits', 'emailVerificationSends', 'offerState', 'searchSyncErrors', 'settingsHistory', 'customers', 'customerNotes', 'returnRequests', 'returnStaffNotes', 'returnEmails']);
    }
  }
}
