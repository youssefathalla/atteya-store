rules_version = '2';

// Three roles:
//  - Visitor (signed out): public storefront reads only.
//  - Normal user (signed in, no admin claim): same as a visitor, plus read of their own roles/{uid} mirror.
//  - Admin (token.role == 'admin' AND session not revoked): manage store content.
// roles/ and auditLogs/ are written only by the Admin SDK (Cloud Functions / scripts).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin' && sessionIsCurrent();
    }

    // An ID token keeps role:admin until it expires. After refresh tokens are
    // revoked, roles/{uid}.revokeTimeMs is the Auth tokensValidAfterTime in
    // milliseconds. Sessions that started before that time are rejected.
    // A missing mirror, or a mirror with no revokeTimeMs, stays allowed.
    function sessionIsCurrent() {
      let rolePath = /databases/$(database)/documents/roles/$(request.auth.uid);
      return !exists(rolePath) || freshSession(get(rolePath).data);
    }

    function freshSession(data) {
      return !('revokeTimeMs' in data)
        || ('auth_time' in request.auth.token
            && request.auth.token.auth_time * 1000 >= data.revokeTimeMs);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Rules cannot sum a map, so stock == sum(stockBySize) is enforced by
    // stockFields() in functions/src/products/stock.ts, not here.
    // The Admin SDK (import and migration) skips these rules.
    function validStock(data) {
      return !('stock' in data) || (
        data.stock is int && data.stock >= 0 && data.inStock == (data.stock > 0)
        && (!('stockBySize' in data) || (data.stockBySize is map && data.stockBySize.size() <= 20))
      );
    }

    // Storefront content: settings/home, settings/navigation, settings/shipping,
    // settings/currency, and sibling docs.
    // Visitors and normal users can read these. Only an admin with a current session can write them.
    // settings/currency holds combined display factors and is written only by Cloud Functions.
    // Subcollections under settings are denied. The app does not write them.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() && docId != 'currency';
    }

    // Markup and raw exchange rates. Admin SDK (callables and the daily schedule) is the only writer.
    // Clients, including admins, cannot create or edit these docs.
    match /intlPricing/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Role mirror and audit trail. The Admin SDK (script and callables) is the
    // only writer. Clients, including admins, cannot create or edit these.
    // The signed-in person can read their own mirror so the app can refresh a changed role.
    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Products: storefront can read published products; only admins write.
    // Public queries MUST include where('published', '==', true) or they are rejected.
    match /products/{productId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validStock(request.resource.data);
      allow delete: if isAdmin();
    }

    // Categories and brands: storefront can read published docs; only admins write.
    // Public queries MUST include where('published', '==', true) or they are rejected.
    match /categories/{categoryId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /brands/{brandId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Offers: public active offers can be read by shoppers; only admins write.
    // Coupon codes (offerCodes) are admin-only; usage counters (offerUsage) are Admin SDK only.
    match /offers/{offerId} {
      allow get, list: if (resource.data.active == true && resource.data.visibility == 'public') || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /offerCodes/{offerId} {
      allow read, write: if isAdmin();
    }

    match /offerUsage/{offerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny by default. Admins can reach future collections, but a matching
    // {document=**} rule is OR-ed with the rules above, so settings, roles,
    // auditLogs, products, categories, brands, offers, offerCodes, offerUsage,
    // and intlPricing stay on the rules written for them.
    match /{collection}/{document=**} {
      allow read, write: if isAdmin() && !(collection in ['settings', 'roles', 'auditLogs', 'products', 'categories', 'brands', 'offers', 'offerCodes', 'offerUsage', 'intlPricing']);
    }
  }
}
