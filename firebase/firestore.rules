rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Storefront content: settings/home, settings/navigation, and sibling docs.
    // Visitors can read these. Only an admin custom claim can write them.
    // Subcollections are not public; they fall through to the admin catch-all.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Role mirror and audit trail. The Admin SDK (script and callables) is the
    // only writer. Clients, including admins, cannot create or edit these.
    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny by default. Admins can reach future collections, but a matching
    // {document=**} rule is OR-ed with the rules above, so roles and auditLogs
    // stay closed even for admins.
    match /{collection}/{document=**} {
      allow read, write: if isAdmin() && !(collection in ['roles', 'auditLogs']);
    }
  }
}
