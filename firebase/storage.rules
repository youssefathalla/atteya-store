rules_version = '2';

// Visitors and normal users may get a single public image.
// Admins and staff (claim + current session) may list those folders, upload a valid image,
// and delete files other than the default hero.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function canManageStore() {
      return isSignedIn()
        && request.auth.token.role in ['admin', 'staff']
        && sessionIsCurrent();
    }

    // Matches firestore.rules. The old ID token is rejected once
    // roles/{uid}.revokeTimeMs records the Auth revocation time.
    function sessionIsCurrent() {
      let rolePath = /databases/(default)/documents/roles/$(request.auth.uid);
      return !firestore.exists(rolePath) || freshSession(firestore.get(rolePath).data);
    }

    function freshSession(data) {
      return !('revokeTimeMs' in data)
        || ('auth_time' in request.auth.token
            && request.auth.token.auth_time * 1000 >= data.revokeTimeMs);
    }

    function isImageFolder(folder) {
      return folder in ['hero', 'categories', 'products', 'brands'];
    }

    function isValidImage() {
      return request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    // Single-object reads stay public so the Storage SDK can fetch one file.
    // Listing a folder is admin-only. The storefront loads images by URL, not by list.
    // Writes are admin-only, and only for a real raster image under 10 MB.
    // The default hero file cannot be deleted.
    match /{folder}/{path=**} {
      allow get: if isImageFolder(folder);
      allow list: if canManageStore() && isImageFolder(folder);
      allow create, update: if canManageStore() && isImageFolder(folder) && isValidImage();
      allow delete: if canManageStore()
        && isImageFolder(folder)
        && !(folder == 'hero' && path == 'default-hero.jpg');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
