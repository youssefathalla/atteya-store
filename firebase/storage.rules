rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read, validated uploads, and cleanup deletion for storefront hero images
    match /hero/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    // Default security rule: require authentication
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
