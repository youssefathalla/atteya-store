{
  "worktree": {
    "baseRef": "head"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": ["Bash", "PowerShell", "mcp__claude_ai_Linear", "mcp__Linear"],
    "ask": ["mcp__claude_ai_Linear__delete_comment", "mcp__claude_ai_Linear__merge_diff"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/check-branch-name.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
