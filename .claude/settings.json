{
  "worktree": {
    "baseRef": "head"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Linear",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git fetch *)",
      "Bash(npm run preflight *)",
      "Bash(npm run test:cart *)",
      "Bash(npm run sync:agents *)",
      "Bash(npm run sync:engine *)",
      "Bash(npm test --prefix functions *)",
      "Bash(npx ng build *)",
      "PowerShell(npm run preflight *)",
      "PowerShell(npm run test:cart *)",
      "PowerShell(npm run sync:agents *)",
      "PowerShell(npm run sync:engine *)",
      "PowerShell(npm test --prefix functions *)",
      "PowerShell(npx ng build *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run list *)"
    ],
    "ask": [
      "mcp__claude_ai_Linear__delete_comment",
      "mcp__claude_ai_Linear__delete_attachment",
      "mcp__claude_ai_Linear__delete_diff_comment",
      "mcp__claude_ai_Linear__delete_status_update",
      "mcp__claude_ai_Linear__merge_diff"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/check-branch-name.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
