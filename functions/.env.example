# Reject callable requests that fail App Check.
# The reCAPTCHA Enterprise site keys are already in the Angular environments.
# Set true per project only after the Firebase console shows App Check
# verified traffic close to 100% (otherwise real shoppers get rejected).
APP_CHECK_ENFORCED=false

# Public Algolia Application ID override (optional; defaults per Firebase project ID).
# Write API key is stored in Secret Manager as ALGOLIA_WRITE_KEY (never in .env files).
ALGOLIA_APP_ID=

# --- Paymob Egypt Accept (Intention + Unified Checkout) ---
# Secrets PAYMOB_SECRET_KEY and PAYMOB_HMAC_SECRET live in Secret Manager only
# (firebase functions:secrets:set). Never put them in this file or git.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_PUBLIC_KEY=
# Comma-separated Integration IDs from Dashboard → Settings → Payment Integrations
PAYMOB_INTEGRATION_IDS=
# Public storefront origin for Paymob return URLs and order email links (no trailing slash).
# Dev App Hosting: https://atteya-store--atteya-store-dev.europe-west4.hosted.app
# Use http://localhost:4200 only when testing Paymob locally; emails and webhooks need HTTPS.
STOREFRONT_URL=https://atteya-store--atteya-store-dev.europe-west4.hosted.app
# Absolute HTTPS URL of the paymobWebhook function (set after first deploy)
# Example: https://europe-west3-atteya-store-dev.cloudfunctions.net/paymobWebhook
PAYMOB_NOTIFICATION_URL=

# --- Order emails (Resend) ---
# Secret RESEND_API_KEY lives in Secret Manager only:
#   firebase functions:secrets:set RESEND_API_KEY
# Sender: atteyastore.com is the store's sending domain (added to Resend, region eu-west-1).
# Use the Resend test sender `Atteya Store <onboarding@resend.dev>` only while the domain
# is not verified: it only delivers to the Resend account owner's own address.
RESEND_FROM=Atteya Store <support@atteyastore.com>
# Where shopper replies go (optional; empty = replies go to RESEND_FROM).
RESEND_REPLY_TO=support@atteyastore.com
# Inbox for new-order alerts (empty = no alert).
STORE_ALERT_EMAIL=
