# Reject callable requests that fail App Check.
# Leave false until reCAPTCHA Enterprise site keys are registered for
# atteya-store-dev and attiya-store and placed in the Angular environments.
APP_CHECK_ENFORCED=false

# Public EasyOrders store headers. These are not secrets.
# Currency-Id comes from the store page __NEXT_DATA__.props.pageProps.currencyId.
# The API returns {"message":"success"} with no products when Origin is missing.
EASYORDERS_CURRENCY_ID=d3379j525xzj5803jxx452d2fj24v4f6006fff9v2x66246jz6584z9d6z4v1v03
EASYORDERS_ORIGIN=https://www.atteyastore.com

# Public Algolia Application ID override (optional; defaults per Firebase project ID).
# Write API key is stored in Secret Manager as ALGOLIA_WRITE_KEY (never in .env files).
ALGOLIA_APP_ID=

# --- Paymob Egypt Accept (Intention + Unified Checkout) ---
# Secrets PAYMOB_SECRET_KEY and PAYMOB_HMAC_SECRET live in Secret Manager only
# (firebase functions:secrets:set). Never put them in this file or git.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_PUBLIC_KEY=
# Comma-separated Integration IDs from Dashboard → Settings → Payment Integrations
PAYMOB_INTEGRATION_IDS=
# Public storefront origin for redirection_url (no trailing slash)
STOREFRONT_URL=http://localhost:4200
# Absolute HTTPS URL of the paymobWebhook function (set after first deploy)
# Example: https://europe-west3-atteya-store-dev.cloudfunctions.net/paymobWebhook
PAYMOB_NOTIFICATION_URL=
